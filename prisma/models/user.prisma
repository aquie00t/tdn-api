model User {
  id String @id @default(uuid())

  email    String @unique
  username String @unique

  password        String? //Hashed password
  isEmailVerified Boolean @default(false)

  isBot              Boolean             @default(false)
  botToken           String?
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  oauthAccounts OAuthAccount[]

  profile Profile?

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  // Blocking is stored directionally but read as a union, so a user needs
  // both sides of it: who they shut out, and who shut them out.
  blocking  Block[] @relation("UserBlocking")
  blockedBy Block[] @relation("UserBlockedBy")

  receivedNotifications Notification[] @relation("ReceivedNotifications")
  issuedNotifications   Notification[] @relation("IssuedNotifications")

  posts            Post[]
  interests        UserInterest[]
  postLikes        PostLike[]
  postBookmarks    PostBookmark[]
  comments         Comment[]
  commentBookmarks CommentBookmark[]

  mediaAssets      MediaAsset[]
  articles         Article[]
  articleLikes     ArticleLike[]
  articleBookmarks ArticleBookmark[]

  // Two relations rather than one because a direct conversation stores its
  // pair ordered; the repository resolves a user's conversations from both.
  conversationsAsA Conversation[] @relation("ConversationsAsA")
  conversationsAsB Conversation[] @relation("ConversationsAsB")
  messages         Message[]

  // Who this user was @-mentioned by. The relation stores ids rather than the
  // handle written in the body, so a rename keeps every historical mention
  // pointing at the right account and rendering the current username.
  mentionedInPosts    Post[]    @relation("PostMentions")
  mentionedInComments Comment[] @relation("CommentMentions")
  mentionedInArticles Article[] @relation("ArticleMentions")

  deletedAt DateTime?

  /// When the account was suspended, null while it is in good standing.
  /// Written by hand from the database - no endpoint sets it - and read on
  /// every request that carries a token, so a ban takes effect at once
  /// rather than when the current access token expires.
  bannedAt DateTime?

  /// When the paid verification badge expires, null for an account that has
  /// never had one.
  ///
  /// Denormalised from the subscription because every read that shows an
  /// author shows the badge - roughly a dozen queries - and none of them
  /// should be joining a billing table to render a tick.
  ///
  /// A date rather than a boolean so that it expires on its own. A missed
  /// provider notification then costs the badge at the end of the period the
  /// user paid for, which is the failure everybody can live with; a boolean
  /// would leave it on for good.
  verifiedUntil DateTime?

  /// The billing relationship, if this account has ever had one.
  subscription Subscription?

  /// When the user opted out of the daily digest, null while subscribed.
  /// Written by the unsubscribe link, which carries a signed token and needs
  /// no session - a digest lands in an inbox long after one has expired.
  digestOptOutAt DateTime?

  digestDeliveries DigestDelivery[]

  /// Both directions of a report, for the cascade rather than for reading:
  /// a purged account takes its reports and the reports against it with it.
  /// Installations of the app that may be notified for this account.
  deviceTokens DeviceToken[]

  reportsFiled   Report[] @relation("ReportsFiled")
  reportsAgainst Report[] @relation("ReportsAgainst")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commentLikes CommentLike[]

  @@index([botToken])
  @@map("users")
}
