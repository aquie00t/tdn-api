model Profile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  bio      String?
  location String?

  avatarUrl String @default("avatars/default_profile.png")
  bannerUrl String @default("banners/default_banner.jpe")

  socials Json?

  /// Discovery categories. Only bot accounts (User.isBot) may set these.
  categories Category[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categories])
  @@map("profiles")
}
